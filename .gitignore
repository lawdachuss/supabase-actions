# Supabase local environment (contains secrets!)
.env
/supabase/.env

# Remote control credentials for ./remote.sh (contains the service_role key!)
/remote.env

# OS files
.DS_Store
Thumbs.db

# Docker volumes (large, generated at runtime)
/volumes/
/supabase/volumes/db/data/
/supabase/volumes/storage/
/supabase/volumes/redis/data/
/supabase/volumes/snippets/
/supabase/volumes/functions/*
# Coolify runtime storage (SSH keys, secrets, project configs)
/supabase/volumes/coolify/
# The logs, cache and migrate edge functions ship with the repo
!/supabase/volumes/functions/logs/
!/supabase/volumes/functions/logs/*
!/supabase/volumes/functions/cache/
!/supabase/volumes/functions/cache/*
!/supabase/volumes/functions/migrate/
!/supabase/volumes/functions/migrate/*
!/supabase/volumes/functions/health/
!/supabase/volumes/functions/health/*
!/supabase/volumes/functions/redis-http/
!/supabase/volumes/functions/redis-http/*

# State archives (database dumps — contain data, never commit)
/supabase/backup.dump
/supabase/backup.dump.new
/supabase/dump.rdb
/supabase/dump.rdb.new
# Redis AOF (multi-part appendonly dir) captured by snapshot-state.sh
/supabase/appendonlydir
/supabase/appendonlydir.new
/supabase/pgsodium_root.key
/supabase/supabase-state.tar.gz
/supabase/supabase-state.tar.gz.new

# Companion Coolify stack: its own DB dump (projects, encrypted creds) and the
# Cloudflare-push throttle marker — same rule as the Supabase state above.
/supabase/coolify_backup.dump
/supabase/coolify_backup.dump.new
/supabase/.cf_push_last

# Rotated Cloudflare OAuth refresh token (SECRET — archived with the state so
# the off-site backup chain survives restarts; never commit it) and the
# snapshot timestamp packed into the state archive for freshness comparison.
/supabase/.cf-creds
/supabase/state-ts
# Transient files used by the restore step's off-site recovery paths
/supabase/supabase-state.tar.gz.kv
/supabase/supabase-state.tar.gz.offsite

# Cloned/test directories (old troubleshooting copies)
/tmp-supabase/
node_modules/
derive-key.cjs
package.json
package-lock.json
job_log.txt
